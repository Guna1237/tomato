# Copy this file to key.properties (same folder) and fill in your values.
# key.properties is gitignored — never commit it.
#
# To generate the keystore (run once in android/app/ folder):
#   keytool -genkey -v -keystore tomato-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias tomato
#
storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=tomato
storeFile=tomato-release.jks
